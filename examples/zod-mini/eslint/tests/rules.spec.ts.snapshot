  }
]
`;

exports[`rules-namespace > no-function-scoped-schema 1`] = `
[
  {
    "ruleId": "zod-mini/no-function-scoped-schema",
    "line": 4,
    "message": "This schema is constructed inside a function and rebuilt on every call. Declare it once at module scope instead."
  }
]
`;

exports[`rules-namespace > no-native-enum 1`] = `
[
  {
    "ruleId": "zod-mini/no-native-enum",
    "line": 8,
    "message": "\`z.nativeEnum()\` is deprecated in Zod 4. Use \`z.enum()\` instead."
  }
]
`;

exports[`rules-namespace > no-promise-schema 1`] = `
[
  {
    "ruleId": "zod-mini/no-promise-schema",
    "line": 3,
    "message": "\`z.promise()\` is deprecated in Zod 4. Await the value before parsing it instead."
  }
]
`;

exports[`rules-namespace > no-reshape-on-refined-object 1`] = `
[
  {
    "ruleId": "zod-mini/no-reshape-on-refined-object",
    "line": 3,
    "message": "\`z.pick()\` throws on an object schema that has checks. Reshape the object before adding checks."
  }
]
`;

exports[`rules-namespace > no-throw-in-refine 1`] = `
[
  {
    "ruleId": "zod-mini/no-throw-in-refine",
    "line": 5,
    "message": "Do not throw errors directly inside a z.refine callback."
  }
]
`;

exports[`rules-namespace > no-transform-in-record-key 1`] = `
[
  {
    "ruleId": "zod-mini/no-transform-in-record-key",
    "line": 3,
    "message": "Transforms in z.record() key schemas cause silent key mutation and potential data loss. Use validators like z.minLength() instead of mutating checks like z.trim() or z.toLowerCase()."
  }
]
`;

