exports[`rules-namespace > no-coerce-boolean 1`] = `
[
  {
    "ruleId": "zod-mini/no-coerce-boolean",
    "line": 3,
    "message": "\`z.coerce.boolean()\` uses \`Boolean()\`, so any non-empty string (including \`\\"false\\"\`) becomes \`true\`. Use \`z.stringbool()\` or an explicit string transform such as \`z.pipe(z.string(), z.transform((v) => v === \\"true\\"))\` instead."
  }
]
`;

exports[`rules-namespace > no-conflicting-checks 1`] = `
[
  {
    "ruleId": "zod-mini/no-conflicting-checks",
    "line": 3,
    "message": "This schema can never match: \`minLength(5)\` conflicts with \`maxLength(2)\`."
  }
]
`;

exports[`rules-namespace > no-duplicate-schema-methods 1`] = `
[
  {
    "ruleId": "zod-mini/no-duplicate-schema-methods",
    "line": 3,
    "message": "Method \`.brand()\` is called more than once in this schema chain."
  }
]
`;

exports[`rules-namespace > no-dynamic-schema-value 1`] = `
[
  {
    "ruleId": "zod-mini/no-dynamic-schema-value",
    "line": 3,
    "message": "This value must be a literal or an imported binding to be hoistable by tools like \`zod-compiler\`."
  }
]
`;

exports[`rules-namespace > no-empty-custom-schema 1`] = `
[
  {
    "ruleId": "zod-mini/no-empty-custom-schema",
